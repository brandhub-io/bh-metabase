# ==============================
# Metabase Environment Variables
# ==============================

# Port exposed on your host machine (Metabase UI)
METABASE_PORT=3001

# Public URL for Metabase site
MB_SITE_URL=http://localhost:3001


# ==============================
# Metabase Internal Database (Postgres)
# ==============================

# Type of database Metabase uses internally
MB_DB_TYPE=postgres

# Name of the database Metabase will connect to
MB_DB_DBNAME=metabase

# Postgres port
MB_DB_PORT=5432

# Postgres credentials
MB_DB_USER=dev_user
MB_DB_PASS=dev_password

# Hostname of your Postgres container (service name or container name)
MB_DB_HOST=backend-postgres_db-1


# ==============================
# Docker Network Configuration
# ==============================

# Shared Docker network that connects Metabase and Postgres
NETWORK=backend_custom_network


# ==============================
# Network Setup Commands (for documentation)
# ==============================
# To create the shared network manually:
#   docker network create backend_custom_network
#
# To connect your running Postgres container to this network:
#   docker network connect backend_custom_network backend-postgres_db-1
#
# Then, when running Metabase:
#   docker compose --env-file .env.dev up -d or COMPOSE_PROFILES=dev-app docker-compose -f docker-compose.yml up
#
# This allows Metabase to connect to Postgres using:
#   MB_DB_HOST=backend-postgres_db-1
